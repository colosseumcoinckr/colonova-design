node_modules/
.gjc/
.zcode/
.claude/
dist/
*.tsbuildinfo
*.log
.DS_Store
.hub/
.local/
# 브라우저·Electron e2e 가 남기는 스크린샷 — 매 실행 다시 쓰이는 산출물이라
# 커밋하면 바이너리 diff 만 쌓인다. 검사는 픽셀이 아니라 단언이 한다.
packages/web/test/*.png
packages/desktop/test/*.png
packages/desktop/release/
packages/desktop/web-dist/
packages/desktop/resources/bin/
.test-logs/
# 재생 벤치(PLAN-HARNESS §3.A)의 결과 파일 — 실행마다 쌓이는 산출물이다.
bench-results/
# 수동으로 뭉친 데스크톱 산물(공유용 tgz) — 릴리스 에셋은 워크플로우가 짓는다.
/*.tgz

# 데스크톱 개발 실행(pnpm dev:desktop)이 남기는 Electron userData 산출물 —
# 캐시 · 쿠키가 들어 커밋하면 안 된다.
packages/desktop/.dev-userData/

# docs/qa 의 증거 스크린샷 — 검증마다 다시 찍히는 산출물이다. 보고서
# 마크다운과 changed-files 목록은 커밋하고 이미지는 남기지 않는다.
docs/qa/**/*.png

# 초대 파일(*.colonova-invite)은 연결 코드(GitHub 토큰)를 담는다 — 받은 파일을
# 레포 폴더에 두거나 끌어 놓다 떨어뜨려도 커밋되지 않게 한다.
*.colonova-invite

# 부품 페이지 스크린샷(scripts/web-fixture-shot.mjs)의 산출물 — 실행마다 다시 찍힌다.
packages/web/fixtures-out/

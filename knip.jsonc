{
  // knip — 죽은 파일 · 유령 의존성 점검. 게이트가 아니라 어드바이저리다:
  // 2026-09-21 pre-push 게이트는 진입점을 테스트로만 잡아 제품 export 전체가
  // '미사용'으로 나온 오경보로 걷었다(lefthook.yml). 제품 진입점이 주 entry 다.
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      // 수동 도구(node scripts/…) · 벤치 · GitHub Pages 사이트 — index.html 이
      // 여덟 js 를 script 로 바로 읽는데 knip 은 html 을 못 읽으므로 js 를 연다.
      "entry": ["scripts/**/*.mjs", "site/index.html", "site/*.js"],
      // windows-repo.test.ts 의 Windows 탐지 명령.
      "ignoreBinaries": ["where.exe", "git.exe"]
    },
    "packages/protocol": {
      // package.json exports(".", "./update")의 소스.
      "entry": ["src/index.ts", "src/update.ts"]
    },
    "packages/daemon": {
      // bin(dist/index.js)과 exports(".", "./credentials", "./environment", "./server")의 소스.
      "entry": ["src/index.ts", "src/credentials.ts", "src/environment.ts", "src/server.ts"]
    },
    "packages/desktop": {
      // main(dist/main.js)과 별도 tsconfig.preload.json + build-preloads.mjs 가
      // 조립하는 preload 둘 — knip 이 못 보는 길이라 여기서 열어 준다.
      "entry": ["src/main.ts", "src/preload.ts", "src/preview-preload.ts", "scripts/*.mjs"]
    },
    "packages/web": {
      // vite 다중 페이지 — dev/*.html 이 fixture 진입점인데 knip 은 html 을 못
      // 읽으므로 자매 .tsx 를 함께 연다(mocks 는 fixture 가 임포트한다).
      "entry": ["index.html", "dev/*.html", "dev/*.tsx"],
      // test/cold 수동 시험이 쓰는데 어디에도 선언돼 있지 않다 — devDep 추가는 따로 결정할 것.
      "ignoreDependencies": ["playwright"]
    }
  }
}
